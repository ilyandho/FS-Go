# Python and tool caches
__pycache__/
*.pyc
.ipynb_checkpoints/
catboost_info/

# Generated by the predictor pipeline: rebuild with predictor/src/folds.sh and predictor/src/ensemble.sh
predictor/models/*.pkl
predictor/models/oof_*.csv

# Raw source data (33 MB each): downloaded by predictor/src/prepare_data.py, the second rebuilt by
# predictor/src/fix_missing_xp.py
predictor/inputs/rolled_player_data_24-25.csv
predictor/inputs/rolled_player_data_24-25_xp_fixed.csv

# Optimizer player data (90 MB each): downloaded and fixed by optimizer/prepare_data.py. Also covers
# the predictor's file if copied here (the beta notebooks do not use it)
optimizer/inputs/rolled_*.csv

# Fitted models from the beta estimator notebooks (about 50 MB each): rerun the notebooks to rebuild
optimizer/beta estimators/league betas/league_models_*
optimizer/beta estimators/opponent betas/estimates/manager_fits_*.joblib
